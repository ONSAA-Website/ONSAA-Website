# Copy to .env for local development. PUBLIC_* values are inlined into the
# client bundle at build time, so only ever put publishable/non-secret values
# here. The Stripe *secret* key belongs in server/.env, not this file.

# Stripe publishable key used by the donate page.
PUBLIC_STRIPE_KEY=pk_test_replace_me

# Origin of the donations server in server/. Defaults to http://localhost:3000.
PUBLIC_API_BASE=http://localhost:3000
