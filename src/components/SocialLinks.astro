---
// Contact + social chrome, previously duplicated in all nine pages.
// The email glyph below is the copy from the old index.html; the copy that had
// been pasted into donate-success.html carried a malformed arc command
// ("A1.75 0 0 1", one parameter short), which rendered incorrectly there.
const instagramUrl = "https://www.instagram.com/ontariostudentstrike/";
const emailAddress = "on.students.against.austerity@gmail.com";
const whatsappUrl = "https://chat.whatsapp.com/K07KZM3C9kG0igpzA9Z2VH";
const discordUrl = "https://discord.gg/tbHFBxeZJM";
---

<div class="social-links" aria-label="Social and contact links">
  <a
    class="social-link"
    href={instagramUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Follow ONSAA on Instagram"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 1.8A3.96 3.96 0 0 0 3.8 7.75v8.5a3.96 3.96 0 0 0 3.95 3.95h8.5a3.96 3.96 0 0 0 3.95-3.95v-8.5a3.96 3.96 0 0 0-3.95-3.95h-8.5ZM12 7.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 1.8a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Zm5.1-2.95a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z" />
    </svg>
  </a>

  <a
    class="social-link social-link-email"
    href={`mailto:${emailAddress}`}
    aria-label="Email ONSAA"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M3 6.75A1.75 1.75 0 0 1 4.75 5h14.5A1.75 1.75 0 0 1 21 6.75v10.5A1.75 1.75 0 0 1 19.25 19H4.75A1.75 1.75 0 0 1 3 17.25V6.75Zm1.8.42v.19l7.2 5.4 7.2-5.4v-.19a.35.35 0 0 0-.35-.35H5.15a.35.35 0 0 0-.35.35Zm14.4 2.44-6.66 5a.9.9 0 0 1-1.08 0l-6.66-5v7.64c0 .2.16.35.35.35h13.7c.19 0 .35-.15.35-.35V9.61Z" />
    </svg>
  </a>

    <a
    class="social-link social-link-whatsapp"
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Message ONSAA on WhatsApp"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="currentColor"
        d="M20.52 3.48A11.82 11.82 0 0 0 12.1 0C5.57 0 .25 5.32.25 11.85c0 2.09.54 4.13 1.57 5.93L.15 23.9l6.27-1.64a11.8 11.8 0 0 0 5.67 1.44h.01c6.53 0 11.85-5.32 11.85-11.85 0-3.16-1.23-6.12-3.43-8.37ZM12.1 21.7a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.72.97.99-3.63-.24-.37a9.84 9.84 0 1 1 8.36 4.62Zm5.4-7.39c-.3-.15-1.78-.88-2.05-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.96 1.18-.18.2-.35.22-.65.07-1.78-.89-2.95-1.58-4.12-3.59-.31-.53.31-.49.89-1.63.1-.2.05-.37-.02-.52-.07-.15-.68-1.63-.93-2.23-.25-.59-.5-.51-.68-.52h-.58c-.2 0-.53.07-.8.37-.28.3-1.05 1.03-1.05 2.51s1.08 2.92 1.23 3.12c.15.2 2.13 3.25 5.16 4.56.72.31 1.28.5 1.72.64.72.23 1.37.2 1.89.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.31.18-1.43-.07-.13-.25-.2-.53-.35Z"
      />
    </svg>
  </a>

  <a
    class="social-link social-link-discord"
    href={discordUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Join the ONSAA Discord server"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="currentColor"
        d="M20.32 4.37A19.8 19.8 0 0 0 15.43 2.8a13.5 13.5 0 0 0-.63 1.3 18.37 18.37 0 0 0-5.6 0 13.2 13.2 0 0 0-.64-1.3 19.68 19.68 0 0 0-4.9 1.58C.56 9.03-.26 13.56.15 18.03a19.9 19.9 0 0 0 6 3.04c.49-.67.92-1.39 1.28-2.15a12.4 12.4 0 0 1-2.01-.96c.17-.13.34-.26.5-.4 3.88 1.82 8.1 1.82 11.94 0 .17.14.34.27.5.4-.64.38-1.31.7-2.01.96.36.76.79 1.48 1.28 2.15a19.86 19.86 0 0 0 6.01-3.04c.48-5.18-.82-9.67-3.32-13.66ZM8.02 15.31c-1.16 0-2.1-1.06-2.1-2.37s.93-2.37 2.1-2.37c1.17 0 2.12 1.07 2.1 2.37 0 1.31-.93 2.37-2.1 2.37Zm7.96 0c-1.16 0-2.1-1.06-2.1-2.37s.93-2.37 2.1-2.37c1.17 0 2.12 1.07 2.1 2.37 0 1.31-.93 2.37-2.1 2.37Z"
      />
    </svg>
  </a>

</div>
