---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About us | ONSAA"
  description="Learn about ONSAA and what we organize for."
  current="/about-us/"
  contentMax="980px"
>
  <section class="page-shell">
    <div class="inner-shell">
      <section class="page-header">
        <p class="eyebrow">Student organizing across Ontario</p>
        <h1>About us</h1>
      </section>

      <div class="section-stack">
        <section class="content-panel">
          <h2>Who we are</h2>

          <p class="lead">
            Ontario Students Against Austerity (ONSAA) is a grassroots network of
            student organizers formed to fight austerity.
          </p>

          <p>
            We seek to build students’ political consciousness through political
            education and organizing. We are working toward a combative and militant
            student movement capable of forming a broad anti-austerity coalition.
          </p>

          <p>
            That coalition brings together anti-imperialists, organized labour,
            tenants’ associations, and anyone committed to eliminating austerity at
            its root.
          </p>
        </section>

        <div class="card-grid">
          <article class="card">
            <h3>Political education</h3>
            <p>
              We host workshops, presentations, and open meetings with the aim of helping students develop skills to analyze the broader political and economic structures behind
              austerity.
            </p>
          </article>

          <article class="card">
            <h3>Collective organizing</h3>
            <p>
              We believe students can fight effectively when they organize together and take collective action on campus and beyond.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .section-stack {
    margin-top: 5px;
    display: grid;
    gap: 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 0;
  }

  .content-panel,
  .card {
    background: transparent !important;
    backdrop-filter: none !important;
    box-shadow: none !important;
    border: 0 !important;
  }

  .content-panel,
  .card-grid {
    margin-left: 0;
  }

  .lead,
  .content-panel p,
  .card p,
  .card li {
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.65;
    font-size: 1rem;
  }

  .content-panel h2,
  .card h3 {
    margin: 0 0 12px;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 6px 0 6px 12px;
    border-left: 5px solid var(--accent);
  }

  @media (max-width: 900px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
