---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About us | ONSAA"
  description="Learn about ONSAA and what we organize for."
  current="/about-us/"
  contentMax="980px"
>
  <section class="page-shell">
    <div class="inner-shell">
      <section class="page-header">
        <p class="eyebrow">Student organizing across Ontario</p>
        <h1>About us</h1>
      </section>

      <div class="section-stack">
        <section class="content-panel"></section>

        <div class="card-grid">
          <article class="card"></article>
          <article class="card"></article>
          <article class="card"></article>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .section-stack {
    display: grid;
    gap: 18px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 18px;
  }

  .lead,
  .content-panel p,
  .card p,
  .card li {
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.65;
    font-size: 1rem;
  }

  .content-panel h2,
  .card h3 {
    margin: 0 0 12px;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
