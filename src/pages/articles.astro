---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// timeZone UTC is load-bearing: a bare "2026-07-29" in frontmatter parses as
// UTC midnight, which formats as the 28th in any timezone west of Greenwich.
const dateFormat = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title="Articles | ONSAA"
  description="Articles and writing from ONSAA."
  current="/articles/"
  contentMax="1040px"
>
  <section class="page-shell">
    <div class="inner-shell">
      <section class="page-header">
        <h1>Articles</h1>
      </section>

      <section class="article-list">
        {
          articles.map((article) => (
            <article class="article-card">
              <p class="article-type">
                {article.data.type} — {dateFormat.format(article.data.date)}
              </p>

              <h2>
                <a
                  class="article-title-link"
                  href={`/articles/${article.id}/`}
                >
                  {article.data.title}
                </a>
              </h2>

              <p>{article.data.summary}</p>

              <a
                class="read-more"
                href={`/articles/${article.id}/`}
              >
                Read article
              </a>

              {article.data.link && (
                <a class="external-link" href={article.data.link}>
                  Original source
                </a>
              )}
            </article>
          ))
        }
        {
          articles.length === 0 && (
            <article class="article-card">
              <p>No articles yet. Check back soon.</p>
            </article>
          )
        }
      </section>
    </div>
  </section>
</Layout>

<style is:global>
  .article-list {
    display: grid;
    gap: 18px;
  }

  .article-type {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .article-card h2 {
    margin: 0 0 10px;
    color: #fff;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .read-more {
    display: inline-flex;
    margin-top: 12px;
    color: #fff;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .article-title-link {
    color: inherit;
    text-decoration: none;
  }

  .article-title-link:hover,
  .read-more:hover,
  .external-link:hover {
    text-decoration: underline;
  }

  .external-link {
    display: inline-flex;
    margin-top: 12px;
    margin-left: 14px;
    color: #bbb;
    font-size: 0.85rem;
    text-decoration: none;
  }

</style>
