---
// Uses a custom SVG + Leaflet API to achieve a blank province outline with pixel-coordinate cities
// Nearby markers auto-cluster into a clickable badge
// Hovering a single marker shows its popup; "zoom out" button resets the view
// No free pan/scroll/drag; click and hover interaction only

import Layout from "../layouts/Layout.astro";
import ontarioMap from "../assets/ontario-map.png";

const imgWidth = 860;
const imgHeight = 1000;

// [y, x] pixel positions measured directly on the source PNG at its natural size.
const chapters = [
  { id: "toronto", name: "Toronto", y: 120, x: 645, blurb: "UofT, OCAD", instagram: "tostudentsagainstausterity" },
  { id: "hamilton", name: "Hamilton", y: 90, x: 620, blurb: "McMaster University", instagram: "studentsagainstausterity" },
  { id: "london", name: "London", y: 65, x: 550, blurb: "Western University", instagram: "londonstudentsagainstausterity" },
  { id: "guelph", name: "Guelph", y: 120, x: 590, blurb: "University of Guelph", instagram: "gsaa_official" },
];

const clickZoomStep = 3;
---

<Layout
  title="Our chapters | ONSAA"
  description="Find an ONSAA chapter near you."
  current="/chapter-map/"
  contentMax="900px"
>
  <section class="page-shell map-page">
    <div class="inner-shell">
      <div class="map-wrap">
        <div id="map"></div>
        <button id="zoom-out-btn" class="zoom-out-btn" style="display:none;">← Zoom out</button>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ chapters, imgWidth, imgHeight, clickZoomStep, mapSrc: ontarioMap.src }}>
  function loadLeafletAndCluster(callback) {
    function loadScript(src) {
      return new Promise((resolve) => {
        const script = document.createElement("script");
        script.src = src;
        script.onload = resolve;
        document.head.appendChild(script);
      });
    }
    function loadCss(href) {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = href;
      document.head.appendChild(link);
    }

    loadCss("https://unpkg.com/leaflet@1.9.4/dist/leaflet.css");
    loadCss("https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css");
    loadCss("https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css");

    loadScript("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js").then(() => {
      loadScript("https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js").then(callback);
    });
  }

  loadLeafletAndCluster(() => {
    const map = L.map("map", {
      crs: L.CRS.Simple,
      minZoom: -3,
      maxZoom: 4,
      zoomSnap: 0.25,
      zoomControl: false,
      scrollWheelZoom: false,
      dragging: false,
      doubleClickZoom: false,
      touchZoom: false,
      boxZoom: false,
      keyboard: false,
      tap: false,
      attributionControl: false,
    });

    const bounds = [[0, 0], [imgHeight, imgWidth]];
    L.imageOverlay(mapSrc, bounds).addTo(map);

    map.fitBounds(bounds);
    const homeZoom = map.getZoom();
    const homeCenter = map.getCenter();

    const zoomOutBtn = document.getElementById("zoom-out-btn");

    const clusterGroup = L.markerClusterGroup({
      showCoverageOnHover: false,
      spiderfyOnMaxZoom: false,
      maxClusterRadius: 60,
      iconCreateFunction: function (cluster) {
        return L.divIcon({
          html: `<div class="cluster-dot">${cluster.getChildCount()}</div>`,
          className: "cluster-dot-wrap",
          iconSize: L.point(32, 32),
        });
      },
    });

    chapters.forEach((c) => {
      const igHandle = c.instagram;
      const popupHtml = `
        <div class="leaflet-popup-custom">
          <h2>${c.name}</h2>
          <p>${c.blurb}</p>
          <hr class="popup-divider" />
          <a href="https://instagram.com/${igHandle}" target="_blank" rel="noopener noreferrer" class="popup-ig-link" aria-label="Follow ${c.name} chapter on Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 1.8A3.96 3.96 0 0 0 3.8 7.75v8.5a3.96 3.96 0 0 0 3.95 3.95h8.5a3.96 3.96 0 0 0 3.95-3.95v-8.5a3.96 3.96 0 0 0-3.95-3.95h-8.5ZM12 7.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 1.8a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Zm5.1-2.95a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z" />
            </svg>
            <span class="sr-only">@${igHandle}</span>
          </a>
        </div>
      `;

      const marker = L.marker([c.y, c.x], {
        icon: L.divIcon({
          html: `<div class="marker-icon"><div class="single-dot"></div><span class="marker-label">${c.name}</span></div>`,
          className: "single-dot-wrap",
          iconSize: L.point(80, 32),
          iconAnchor: L.point(40, 6),
        }),
      });

      marker.bindPopup(popupHtml, { closeButton: false, offset: [0, -10] });
      
      let closeTimeout;

      marker.on("mouseover", () => {
        clearTimeout(closeTimeout);
        marker.openPopup();
      });

      marker.on("mouseout", () => {
        closeTimeout = setTimeout(() => {
          const popupEl = marker.getPopup().getElement();
          if (popupEl && popupEl.matches(":hover")) return;
          marker.closePopup();
        }, 100);
      });

      marker.on("popupopen", () => {
        const popupEl = marker.getPopup().getElement();
        if (popupEl) {
          popupEl.addEventListener("mouseenter", () => clearTimeout(closeTimeout));
          popupEl.addEventListener("mouseleave", () => marker.closePopup());
        }
      });

      marker.on("click", (e) => {
        L.DomEvent.stopPropagation(e);
      });

      clusterGroup.addLayer(marker);
    });

    clusterGroup.on("clusterclick", (e) => {
      L.DomEvent.stopPropagation(e.originalEvent);

      const targetZoom = Math.min(
        homeZoom + clickZoomStep,
        map.getMaxZoom()
      );

      map.setView(e.layer.getLatLng(), targetZoom, {
        animate: false,
      });

      zoomOutBtn.style.display = "block";
    });

    map.addLayer(clusterGroup);

    zoomOutBtn.addEventListener("click", () => {
      map.setView(homeCenter, homeZoom, { animate: false, });
      zoomOutBtn.style.display = "none";
    });
  });
</script>

<style is:global>
  .map-page.page-shell {
    display: flex;
    flex-direction: column;
    padding: 16px;
    overflow: hidden;
  }

  .map-page .inner-shell {
    flex: 1;
    display: flex;
    min-height: 0;
    width: 100%;
  }

  .map-wrap {
    position: relative;
    flex: 1;
    min-height: 0;
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
  }

  #map {
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 10, 0.6);
  }

  .marker-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    pointer-events: auto;
  }

  .marker-label {
    color: #e13434;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  .leaflet-image-layer {
    filter: invert(1);
  }

  .leaflet-popup-content-wrapper {
    background: rgba(10, 10, 10, 0.94) !important;
    color: #fff !important;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
  }

  .leaflet-popup-content {
    margin: 12px 14px;
    color: #fff !important;
  }

  .leaflet-popup-tip {
    background: rgba(10, 10, 10, 0.94) !important;
  }

  .leaflet-popup-custom {
    color: #fff !important;
    background: transparent !important;
  }

  .leaflet-popup-custom h2 {
    color: #fff !important;
  }

  .leaflet-popup-custom p {
    color: rgba(255, 255, 255, 0.85) !important;
  }

  .marker-cluster,
  .marker-cluster div,
  .leaflet-marker-icon {
    transition-duration: 100ms !important;
  }

  .popup-divider {
    width: 100%;
    margin: 10px 0;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .popup-ig-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: #ff3b30; !important
    transition: transform 150ms ease, opacity 150ms ease;
  }

  .popup-ig-link svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .popup-ig-link:hover,
  .popup-ig-link:focus-visible {
    opacity: 0.85;
    transform: scale(1.15);
  }

  .single-dot-wrap {
    background: transparent;
    border: none;
  }

  .single-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #e13434;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3);
  }

  .cluster-dot-wrap {
    background: transparent;
    border: none;
  }

  .cluster-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ff3b30;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    border: 2px solid rgba(255, 255, 255, 0.8);
  }

  .zoom-out-btn {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1000;
    background: rgba(10, 10, 10, 0.85);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .zoom-out-btn:hover {
    background: rgba(255, 59, 48, 0.85);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>