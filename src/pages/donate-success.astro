---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/url";
---

<Layout
  title="Donation received | ONSAA"
  description="Thank you for supporting ONSAA."
  current="/donate/"
  contentMax="980px"
>
  <section class="page-shell">
    <div class="inner-shell">
      <div class="success-panel">
        <p class="success-kicker">Contribution received</p>
        <h1 class="success-title">Thank you</h1>
        <p class="success-copy">
          Your donation helps fund organizing, materials, outreach, and
          student-led actions across Ontario. Every contribution strengthens the
          work.
        </p>

        <div class="success-actions">
          <a href={url("/")}>Return home</a>
          <a href={url("/volunteer/")}>Volunteer with us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .success-content {
    width: min(760px, 100%);
    margin-inline: auto;
  }

  .success-panel {
    position: relative;
    padding: 28px;
    border: 1px solid rgba(215, 25, 32, 0.28);
    border-radius: 22px;
    background:
      linear-gradient(180deg, rgba(215, 25, 32, 0.05), rgba(0, 0, 0, 0.28)),
      rgba(8, 8, 8, 0.5);
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
  }

  .success-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
  }

  .success-kicker,
  .success-copy {
    font-family: var(--font-sans);
  }

  .success-kicker {
    margin: 0 0 12px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 800;
  }

  .success-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.8rem, 8vw, 5.8rem);
    line-height: 0.92;
    letter-spacing: -0.08em;
    text-transform: uppercase;
    font-weight: 900;
  }

  .success-copy {
    margin: 14px 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 54ch;
  }

  .success-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 22px;
  }

  .success-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 18px;
    border: 1px solid rgba(215, 25, 32, 0.58);
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(215, 25, 32, 0.16), rgba(0, 0, 0, 0.52)),
      rgba(0, 0, 0, 0.36);
    color: rgba(255, 255, 255, 0.94);
    text-decoration: none;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (max-width: 720px) {
    .success-panel {
      padding: 22px 18px;
    }

    .success-title {
      font-size: clamp(2.4rem, 15vw, 4.6rem);
    }

    .success-actions {
      flex-direction: column;
    }
  }
</style>
