---
import Layout from "../../layouts/Layout.astro";

// TODO: stop spam verification link requests
// TODO: check form html submission security (injections, etc)

// proxy URL (worker)
const APPS_SCRIPT_URL = "https://autumn-term-3542.chrollobrollo.workers.dev/";

// fake data for visualization
const institutions = [
  {
    name: "McGill University",
    courses: [
      {
        code: "COMP 202",
        name: "Foundations of Programming",
        exemption_type: "Retake policy",
        description: "Course may be repeated; highest grade counts toward program GPA.",
        info: "email"
      }
    ]
  },
  {
    name: "University of Toronto",
    courses: [
      {
        code: "CSC 101",
        name: "Introduction to Computer Science",
        exemption_type: "Grade forgiveness",
        description: "Students may retake the course once; the second grade replaces the first in GPA calculations.",
        info: "quercus"
      },
      {
        code: "ECO 100",
        name: "Introductory Economics",
        exemption_type: "Academic renewal",
        description: "After a 2-year break, prior poor performance can be excluded from GPA upon petition.",
        info: "quercus and email"
      }
    ]
  }
];

// sort institutions A–Z by name
const sortedInstitutions = [...institutions].sort((a, b) =>
  a.name.localeCompare(b.name)
);

// flatten all courses with institution info for search
const allCourses = sortedInstitutions.flatMap(inst =>
  inst.courses.map(c => ({
    institution: inst.name,
    code: c.code,
    name: c.name,
    exemption_type: c.exemption_type,
    description: c.description
  }))
);
---

<Layout
  title="Academic Exemption Database | ONSAA"
  description="Browse and submit academic exemptions by course."
  current="/exemption/"
  contentMax="900px"
>
  <section class="page-shell">
    <div class="inner-shell">
      <h1>Academic Exemption Database</h1>
      <p class="intro">
        Browse academic exemptions by institution and course, or submit one if you are a professor or TA.
      </p>

      <div class="tabs">
        <button class="tab-btn active" data-tab="browse">Browse</button>
        <button class="tab-btn" data-tab="submit">Submit</button>
      </div>

      <div id="tab-browse" class="tab-content active">
        <div class="search-wrap">
          <input
            type="text"
            id="course-search"
            placeholder="Search by course code (e.g. CSC, ECO)..."
          />
          <div id="search-results" class="search-results"></div>
        </div>

        <div class="institutions-list" id="institutions-list">
          {sortedInstitutions.map((inst, idx) => (
            <div class="institution-block" data-index={idx}>
              <button class="institution-header">
                <span class="institution-name">{inst.name}</span>
                <span class="chevron">▶</span>
              </button>
              <div class="institution-content">
                {inst.courses.length === 0 ? (
                  <p class="no-courses">No courses listed yet.</p>
                ) : (
                  <div class="courses-list">
                    {inst.courses
                      .slice()
                      .sort((a, b) => (a.code || "").localeCompare(b.code || ""))
                      .map(c => (
                        <div class="course-card">
                          <h3>{c.code} – {c.name}</h3>
                          <p class="exemption-type">{c.exemption_type}</p>
                          <p class="description">{c.description}</p>
                          <p class="info">Find your instructor's announcement: {c.info}</p>
                        </div>
                      ))
                    }
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div id="tab-submit" class="tab-content">
        <div id="verify-step">
          <h2>Verify your institutional email</h2>
          <form id="verify-form">
            <label for="verify-email">Institutional email</label>
            <input
              type="email"
              id="verify-email"
              name="email"
              required
              placeholder="you@university.ca"
            />
            <button id="verify-button" type="submit" class="button">Verify email</button>
          </form>
          <p id="verify-status" class="status"></p>
        </div>

        <div id="submit-step" style="display:none;">
          <h2>Submit academic exemption</h2>
          <form id="exemption-form">
            <label for="institution">Institution</label>
            <div class="autocomplete-wrap">
              <input
                type="text"
                id="institution"
                name="institution"
                required
                placeholder="Start typing your institution..."
                autocomplete="off"
              />
              <p id="institution-status" class="institution-status"></p>
              <div id="institution-results" class="autocomplete-results"></div>
            </div>
            <input type="hidden" id="institution-id" name="institution_id" required />

            <label for="course_code">Course code</label>
            <input type="text" id="course_code" name="course_code" required placeholder="e.g. CS 101" />

            <label for="course_name">Course name</label>
            <input type="text" id="course_name" name="course_name" required />

            <label for="exemption_type">Exemption type</label>
            <select id="exemption_type" name="exemption_type" required>
              <option value="">Select a type</option>
              <option value="Extend a deadline">Extend a deadline</option>
              <option value="Online Asynchronous">Online synchronous class (ex. Zoom)</option>
              <option value="Online Synchronous">Online asynchronous class (recording)</option>
              <option value="Postpone an assessment">Postpone an assessment</option>
              <option value="Other">Other</option>
            </select>

            <label for="description">Description of Exemption</label>
            <textarea id="description" name="description" required rows="4"></textarea>

            <label for="submitter_name">Full name</label>
            <input type="text" id="submitter_name" name="submitter_name" placeholder="John Doe" pattern="^[a-zA-Z]+(?:\s+[a-zA-Z]+)+$" required />
            <p id="name-status" class="status"></p>

            <label for="submitter_email">Your institutional email</label>
            <input
              type="email"
              id="submitter_email"
              name="submitter_email"
              disabled
            />

            <label for="vow" class="checkbox-label">
              <input type="checkbox" id="vow" name="vow" required>
              I agree to commit to this academic exemption and make an announcement to notify my students.
            </label>

            <label for="info">How will you notify students of this exemption?</label>
            <input
              type="text"
              id="info"
              name="info"
              required
              placeholder="e.g. Canvas announcement, email, etc."
            />

            <button type="submit" class="button">Submit</button>
          </form>
          <p id="submit-status" class="status"></p>
        </div>
      </div>
    </div>
  </section>

  <div id="course-modal" class="modal" style="display:none;" aria-hidden="true">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h2>Course details</h2>
        <button id="close-modal" class="modal-close" aria-label="Close">✕</button>
      </div>
      <div class="modal-body">
        <p class="modal-institution"></p>
        <h3 class="modal-code-name"></h3>
        <p class="modal-exemption-type"></p>
        <p class="modal-description"></p>
      </div>
    </div>
  </div>

  <script define:vars={{ allCourses, sortedInstitutions, APPS_SCRIPT_URL }}>
    const courseSearch = document.getElementById("course-search");
    const searchResults = document.getElementById("search-results");
    const institutionsList = document.getElementById("institutions-list");

    const tabBtns = document.querySelectorAll(".tab-btn");
    const tabBrowse = document.getElementById("tab-browse");
    const tabSubmit = document.getElementById("tab-submit");

    const courseModal = document.getElementById("course-modal");
    const modalBackdrop = courseModal.querySelector(".modal-backdrop");
    const closeModalBtn = document.getElementById("close-modal");
    const modalInstitution = courseModal.querySelector(".modal-institution");
    const modalCodeName = courseModal.querySelector(".modal-code-name");
    const modalExemptionType = courseModal.querySelector(".modal-exemption-type");
    const modalDescription = courseModal.querySelector(".modal-description");

    const verifyForm = document.getElementById("verify-form");
    const verifyEmailInput = document.getElementById("verify-email");
    const verifyStatus = document.getElementById("verify-status");

    const submitStep = document.getElementById("submit-step");
    const verifyStep = document.getElementById("verify-step");
    const exemptionForm = document.getElementById("exemption-form");
    const submitStatus = document.getElementById("submit-status");
    const verifyButton = document.getElementById("verify-button");

    const instData = sortedInstitutions;
    const coursesData = allCourses;

    // listen for verification messages from Apps Script

    // on page load, check for verification redirect params
    (async function handleVerificationRedirect() {
      const params = new URLSearchParams(window.location.search);
      const verifiedFlag = params.get("verified");
      const token = params.get("token");
      const email = params.get("email");

      if (verifiedFlag !== "1" || !token) {
        return; // No valid verification redirect
      }

      // clear the query string
      if (window.history && window.history.replaceState) {
        const cleanUrl = window.location.pathname + window.location.hash;
        window.history.replaceState({}, "", cleanUrl);
      }

      // Force Submit tab to be active
      tabBtns.forEach(b => b.classList.remove("active"));
      const submitTabBtn = document.querySelector(".tab-btn[data-tab='submit']");
      if (submitTabBtn) {
        submitTabBtn.classList.add("active");
      }

      tabBrowse.classList.remove("active");
      tabSubmit.classList.add("active");

      // Show verifying state
      verifyStep.style.display = "block";

      // disable button
      verifyButton.style.display = "none";

      submitStep.style.display = "none";
      verifyStatus.textContent = "Confirming verification…";
      verifyStatus.className = "status";

      try {
        // Call check-token with token only
        const res = await fetch(
          APPS_SCRIPT_URL + "?action=check-token&token=" + encodeURIComponent(token) + "&email=" + encodeURIComponent(email)
        );
        const json = await res.json();

        if (json.verified) {
          verifyStatus.textContent = "Email verified. You may now submit your claim.";
          verifyStatus.className = "status success";
          verifyStep.style.display = "none";
          submitStep.style.display = "block";
          verifyEmailInput.textContent = email;
          verifyButton.click();

          // pre-fill and lock the email
          document.addEventListener("DOMContentLoaded", () => {
            const submitterEmailInput = document.getElementById("submitter_email");
            if (submitterEmailInput) {
              submitterEmailInput.value = email; // from verification
              submitterEmailInput.placeholder = email;
            }
          });
  
        } else {
          verifyStatus.textContent = "Verification could not be confirmed. Please request a new verification email.";
          verifyStatus.className = "status error";
        }
      } catch (err) {
        console.error("Verification check failed:", err);
        verifyStatus.textContent = "Failed to confirm verification.";
        verifyStatus.className = "status error";
      }
    })();

    // Handle verification signal URL
    (function handleVerifySignal() {
      const params = new URLSearchParams(window.location.search);
      const signal = params.get("signal-verify");
      const email = params.get("email");
      const token = params.get("token");

      if (signal !== "1" || !email || !token) {
        return;
      }

      // Write to localStorage as signal
      localStorage.setItem("exemption_verified_email", email);
      localStorage.setItem("exemption_verified_token", token);

      // Clear URL
      if (window.history && window.history.replaceState) {
        window.history.replaceState({}, "", window.location.pathname + window.location.hash);
      }

      // Try to close if this is a popup (verification tab)
      setTimeout(() => {
        if (window.opener && !window.opener.closed) {
          window.close();
        }
      }, 300);
    })();

    // Tabs: switch content, red underline on active
    tabBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        tabBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");

        const tabName = btn.dataset.tab;
        if (tabName === "browse") {
          tabBrowse.classList.add("active");
          tabSubmit.classList.remove("active");
        } else {
          tabSubmit.classList.add("active");
          tabBrowse.classList.remove("active");
        }
      });
    });

    // Accordion: toggle institution open/close
    institutionsList.addEventListener("click", (e) => {
      const header = e.target.closest(".institution-header");
      if (!header) return;

      const block = header.closest(".institution-block");
      const content = block.querySelector(".institution-content");
      const chevron = block.querySelector(".chevron");

      const isOpen = block.classList.toggle("open");
      content.style.display = isOpen ? "block" : "none";
      chevron.textContent = isOpen ? "▼" : "▶";
    });

    // Search: show overlay dropdown of matching results
    courseSearch.addEventListener("input", () => {
      const query = courseSearch.value.trim().toLowerCase();
      searchResults.innerHTML = "";
      searchResults.classList.remove("show");

      if (!query) {
        return;
      }

      const matches = coursesData.filter(c =>
        c.code.toLowerCase().includes(query) ||
        c.name.toLowerCase().includes(query) ||
        c.institution.toLowerCase().includes(query)
      );

      if (!matches.length) {
        searchResults.innerHTML = "<div class='no-results'>No matching courses.</div>";
        searchResults.classList.add("show");
        return;
      }

      const list = document.createElement("div");
      list.className = "search-results-list";

      matches.forEach(m => {
        const item = document.createElement("button");
        item.className = "search-result-item";
        item.innerHTML = `
          <span class="result-code">${m.code}</span>
          <span class="result-name">${m.name}</span>
          <span class="result-institution">${m.institution}</span>
        `;
        item.addEventListener("click", () => {
          openCourseModal(m);
        });
        list.appendChild(item);
      });

      searchResults.appendChild(list);
      searchResults.classList.add("show");
    });

    // Close search dropdown when clicking outside
    document.addEventListener("click", (e) => {
      if (!e.target.closest(".search-wrap")) {
        searchResults.classList.remove("show");
      }
    });

    function openCourseModal(course) {
      searchResults.classList.remove("show");

      modalInstitution.textContent = course.institution;
      modalCodeName.textContent = `${course.code} – ${course.name}`;
      modalExemptionType.textContent = course.exemption_type;
      modalDescription.textContent = course.description;

      courseModal.style.display = "flex";
      courseModal.setAttribute("aria-hidden", "false");
    }

    function closeCourseModal() {
      courseModal.style.display = "none";
      courseModal.setAttribute("aria-hidden", "true");
    }

    closeModalBtn.addEventListener("click", closeCourseModal);
    modalBackdrop.addEventListener("click", closeCourseModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && courseModal.style.display === "flex") {
        closeCourseModal();
      }
    });

    // email verification
    verifyForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = verifyEmailInput.value.trim();

      verifyStatus.textContent = "Checking verification status...";
      verifyStatus.className = "status";

      try {
        const res = await fetch(APPS_SCRIPT_URL + "?action=request-verify", {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({ email })
        });

        const json = await res.json();

        if (json.error) {
          verifyStatus.textContent = json.error;
          verifyStatus.className = "status error";
          return;
        }

        if (json.alreadyVerified) {
          verifyStatus.textContent = "Your email is already verified. You may proceed to submit.";
          verifyStatus.className = "status success";
          verifyStep.style.display = "none";
          submitStep.style.display = "block";
          return;
        }

        verifyStatus.textContent = "Verification email sent. Please check your inbox and click the link.\nIf you don't see the email, wait a few minutes and check your junk/spam folder before making another request.";
        verifyStatus.className = "status success";
      } catch (err) {
        console.error(err);
        verifyStatus.textContent = "Failed to send verification email.";
        verifyStatus.className = "status error";
      }
    });

    const institutionInput = document.getElementById("institution");
    const institutionResults = document.getElementById("institution-results");
    const institutionIdInput = document.getElementById("institution-id");
    const institutionStatus = document.getElementById("institution-status");
    const searchableInstitutions = sortedInstitutions.map(inst => ({
      id: inst.name.toLowerCase().replace(/\s+/g, "-"),
      name: inst.name
    }));
    const institutionalEmail = document.getElementById("submitter_email");

    // track if a valid selection was made
    let isValidSelection = false;

    // pre-fill provided institutional email
    institutionalEmail.placeholder = verifyEmailInput.value.trim();

    institutionInput.addEventListener("input", () => {
      const query = institutionInput.value.trim().toLowerCase();
      institutionResults.innerHTML = "";
      institutionResults.classList.remove("show");
  
      // Reset validity and ID while typing
      isValidSelection = false;
      institutionIdInput.value = ""; 

      if (!query) return;

      const matches = searchableInstitutions.filter(inst =>
        inst.name.toLowerCase().includes(query)
      );

      if (!matches.length) return;

      matches.forEach(inst => {
        const btn = document.createElement("button");
        btn.className = "autocomplete-item";
        btn.textContent = inst.name;
        
        // Use mousedown instead of click to fire BEFORE the blur event
        btn.addEventListener("mousedown", (e) => {
          e.preventDefault(); // Prevents input from losing focus early
          institutionInput.value = inst.name;
          institutionIdInput.value = inst.id;
          isValidSelection = true;
          institutionResults.innerHTML = "";
          institutionResults.classList.remove("show");
        });
        institutionResults.appendChild(btn);
      });

      institutionResults.classList.add("show");
    });

    // Enforce the allowlist when the user clicks away (blur)
    institutionInput.addEventListener("blur", () => {
      // Hide results dropdown after a short delay
      setTimeout(() => {
        institutionResults.classList.remove("show");
      }, 200);

    // Check if what they typed exactly matches something in your allowlist array
    const exactMatch = searchableInstitutions.find(
      inst => inst.name.toLowerCase() === institutionInput.value.trim().toLowerCase()
    );

    if (exactMatch) {
      // If they typed it perfectly, lock it in
      institutionInput.value = exactMatch.name;
      institutionIdInput.value = exactMatch.id;
      isValidSelection = true;
      institutionStatus.textContent = "";
    } else if (!isValidSelection) {
      // If not valid, wipe the fields clean and show error message
      institutionInput.value = "";
      institutionIdInput.value = "";
      institutionStatus.textContent = "ⓘ Please choose an institution from the list."
    }
  });

  const nameInput = document.getElementById("submitter_name");
  const nameStatus = document.getElementById("name-status"); // add a <p id="name-status"> under the name input

  let isNameValid = false;

  nameInput.addEventListener("input", () => {
    const query = nameInput.value.trim();

    // Basic full-name regex: letters, spaces, hyphens, apostrophes; at least two words
    const fullNameRegex = /^[a-zA-Z'-]+(?:\s+[a-zA-Z'-]+)+$/;

    if (!fullNameRegex.test(query)) {
      isNameValid = false;
      if (query.length > 0) {
        nameStatus.textContent = "ⓘ Please enter your full name (first and last name).";
        nameStatus.className = "status error";
      } else {
        nameStatus.textContent = "";
      }
    } else {
      isNameValid = true;
      nameStatus.textContent = "";
    }
  });

  nameInput.addEventListener("blur", () => {
    const query = nameInput.value.trim();

    if (!query) {
      isNameValid = false;
      nameStatus.textContent = "";
      return;
    }

    const fullNameRegex = /^[a-zA-Z'-]+(?:\s+[a-zA-Z'-]+)+$/;

    if (!fullNameRegex.test(query)) {
      isNameValid = false;
      nameInput.value = "";
      nameStatus.textContent = "ⓘ Please enter your full name (first and last name).";
      nameStatus.className = "status error";
    } else {
      isNameValid = true;
      nameStatus.textContent = "";
    }
  });

  // SUBMITTING AND UPDATING SPREADSHEET
  exemptionForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(exemptionForm);
    const payload = Object.fromEntries(formData.entries());

    // convert checkbox to boolean
    payload.vow = document.getElementById("vow").checked;

    submitStatus.textContent = "Submitting...";
    submitStatus.className = "status";

    try {
      const res = await fetch(APPS_SCRIPT_URL + "?action=submit-exemption", {
        method: "POST",
        headers: { "Content-Type": "application/json;charset=utf-8" },
        body: JSON.stringify(payload)
      });

      const json = await res.json();

      if (json.error) {
        submitStatus.textContent = json.error;
        submitStatus.className = "status error";
        return;
      }

      submitStatus.textContent = "Exemption submitted successfully.";
      submitStatus.className = "status success";
      exemptionForm.reset();
      // Optionally hide submit-step or redirect
    } catch (err) {
      console.error("Submission failed:", err);
      submitStatus.textContent = "Failed to submit exemption.";
      submitStatus.className = "status error";
    }
  });

  </script>

  <style is:global>
    .page-shell {
      padding: 24px 16px 40px;
    }

    .inner-shell {
      max-width: 900px;
      margin: 0 auto;
    }

    h1 {
      font-size: 1.8rem;
      margin-bottom: 8px;
    }

    .intro {
      margin-bottom: 16px;
      color: rgba(255, 255, 255, 0.85);
    }

    /* Tabs: side-by-side, clear bg, white text, red underline on active */
    .tabs {
      display: flex;
      gap: 18px;
      margin-bottom: 18px;
    }

    .tab-btn {
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      color: #fff;
      padding: 8px 4px 10px;
      font-size: 0.95rem;
      cursor: pointer;
      opacity: 0.8;
      transition: opacity 150ms ease, border-color 150ms ease;
    }

    .tab-btn:hover {
      opacity: 1;
    }

    .tab-btn.active {
      opacity: 1;
      border-bottom-color: rgba(255, 59, 48, 0.95);
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .search-wrap {
      position: relative;
      margin-bottom: 20px;
    }

    .search-wrap input {
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
      font-size: 0.95rem;
    }

    .search-results {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 50;
      display: none;
      max-height: 260px;
      overflow: auto;
      border-radius: 0 0 8px 8px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-top: none;
      background: rgba(10, 10, 10, 0.95);
      backdrop-filter: blur(4px);
      margin-top: 0;
    }

    .search-results.show {
      display: block;
    }

    .no-results {
      padding: 10px 12px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.9rem;
    }

    .search-results-list {
      display: grid;
    }

    .search-result-item {
      width: 100%;
      display: grid;
      grid-template-columns: 110px 1fr auto;
      gap: 10px;
      align-items: center;
      padding: 10px 12px;
      background: transparent;
      border: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      color: #fff;
      text-align: left;
      font-size: 0.9rem;
      cursor: pointer;
    }

    .search-result-item:last-child {
      border-bottom: none;
    }

    .search-result-item:hover {
      background: rgba(255, 255, 255, 0.06);
    }

    .result-code {
      font-weight: 700;
      color: rgba(255, 59, 48, 0.95);
    }

    .result-name {
      color: rgba(255, 255, 255, 0.9);
    }

    .result-institution {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.85rem;
      justify-self: end;
    }

    .institutions-list {
      display: grid;
      gap: 10px;
      margin-bottom: 24px;
    }

    .institution-block {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      overflow: hidden;
    }

    .institution-header {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      background: rgba(255, 255, 255, 0.06);
      border: none;
      color: #fff;
      text-align: left;
      font-size: 0.95rem;
