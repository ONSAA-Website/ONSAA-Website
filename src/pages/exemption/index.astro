```astro
---
import Layout from "../../layouts/Layout.astro";

// TODO: stop spam verification link requests
// TODO: prevent duplicates (email : course : exemption type)
// TODO: check form html submission security (injections, etc)

// proxy URL (worker)
const APPS_SCRIPT_URL = "https://autumn-term-3542.chrollobrollo.workers.dev/";

const ALLOWED_INSTITUTIONS = [
  "McGill University",
  "University of Toronto",
  "University of British Columbia",
  "University of Waterloo",
  "University of Alberta",
  "Queen's University",
  "Western University",
  "Simon Fraser University",
  "York University",
  "Toronto Metropolitan University"
  // TODO: add more
];
---

<Layout
  title="Academic Exemption Database | ONSAA"
  description="Browse and submit academic exemptions by course."
  current="/exemption/"
  contentMax="900px"
>
  <section class="page-shell">
    <div class="inner-shell">
      <h1>Academic Exemption Database</h1>
      <p class="intro">
        Browse academic exemptions by institution and course, or submit one if you are a professor or TA.
      </p>

      <div class="tabs">
        <button class="tab-btn active" data-tab="browse">Browse</button>
        <button class="tab-btn" data-tab="submit">Submit</button>
        <button class="tab-btn" data-tab="report">Report</button>
      </div>

      <div id="tab-browse" class="tab-content active">
        <p class="checkbox-label">
            ⓘ ONSAA is not responsible for incorrect submissions. Please contact your instructor or check for an announcement to verify submissions.
        </p>
        <div class="search-wrap">
          <input
            type="text"
            id="course-search"
            placeholder="Search by course code (e.g. CSC, ECO)..."
          />
          <div id="search-results" class="search-results"></div>
        </div>

        <div class="institutions-list loading-state" id="institutions-list">
          <div class="loading-overlay">
            <div class="modern-spinner"></div>
            <span class="loading-text"></span>
          </div>
        </div>

      </div>

      <div id="tab-submit" class="tab-content">
        <div id="verify-step">
          <h2>Submit exemptions for your classes and/or assessments</h2>
          <p class="intro">
            Verified instructors can submit exemptions for their courses.
          </p>
          <h2>Verify your institutional email</h2>
          <form id="verify-form">
            <label for="verify-email">Institutional email</label>
            <input
              type="email"
              id="verify-email"
              name="email"
              required
              placeholder="you@university.ca"
            />
            <button id="verify-button" type="submit" class="button">Verify email</button>
          </form>
          <p id="verify-status" class="status"></p>
        </div>

        <div id="submit-step" style="display:none;">
          <h2>Submit academic exemption</h2>
          <form id="exemption-form">
            <label for="institution">Institution</label>
            <div class="autocomplete-wrap">
              <input
                type="text"
                id="institution"
                name="institution"
                required
                placeholder="Start typing your institution..."
                autocomplete="off"
              />
              <p id="institution-status" class="institution-status"></p>
              <div id="institution-results" class="autocomplete-results"></div>
            </div>
            <input type="hidden" id="institution-id" name="institution_id" required />

            <label for="course_code">Course code</label>
            <input type="text" id="course_code" name="course_code" required placeholder="e.g. CS 101" />

            <label for="course_name">Course name</label>
            <input type="text" id="course_name" name="course_name" required />

            <label for="exemption_type">Exemption type</label>
            <select id="exemption_type" name="exemption_type" required>
              <option value="">Select a type</option>
              <option value="Extend a deadline">Extend a deadline</option>
              <option value="Online Asynchronous">Online synchronous class (ex. Zoom)</option>
              <option value="Online Synchronous">Online asynchronous class (recording)</option>
              <option value="Postpone an assessment">Postpone an assessment</option>
              <option value="Other">Other</option>
            </select>

            <label for="description">Description of Exemption</label>
            <textarea id="description" name="description" required rows="4"></textarea>

            <label for="submitter_name">Full name</label>
            <input type="text" id="submitter_name" name="submitter_name" placeholder="John Doe" pattern="^[a-zA-Z]+(?:\s+[a-zA-Z]+)+$" required />
            <p id="name-status" class="status"></p>

            <div style="display:none;">
            <label for="submitter_email">Your institutional email</label>
            <input
              type="email"
              id="submitter_email"
              name="submitter_email"
              style="cursor: not allowed; pointer-events: none;"
              readonly
              style="display:none;"
            />
            </div>

            <label for="vow" class="checkbox-label">
              <input type="checkbox" id="vow" name="vow" required>
              I agree to commit to this academic exemption and make an announcement to notify my students.
            </label>

            <label for="info">How will you notify students of this exemption?</label>
            <input
              type="text"
              id="info"
              name="info"
              required
              placeholder="e.g. Canvas announcement, email, etc."
            />

            <button type="submit" class="button">Submit</button>
          </form>
          <p id="submit-status" class="status"></p>
        </div>
      </div>

      <div id="tab-report" class="tab-content">
        <div id="report-verify-step">
          <h2>Report incorrect or false exemptions</h2>
          <p class="intro">
            Only students and instructors with a verified institutional email can submit reports.
          </p>
          <h2>Verify your institutional email</h2>
          <form id="report-verify-form">
            <label for="report-verify-email">Institutional email</label>
            <input
              type="email"
              id="report-verify-email"
              name="email"
              required
              placeholder="you@university.ca"
            />
            <button id="report-verify-button" type="submit" class="button">Verify email</button>
          </form>
          <p id="report-verify-status" class="status"></p>
        </div>

        <div id="report-submit-step" style="display:none;">
          <form id="report-form">
            <label for="report-course_name">Course Name</label>
            <div class="search-wrap">
              <input
                type="text"
                id="report-course_name"
                required
                placeholder="Search exemption by course code (e.g. CSC, ECO)..."
              />
              <div id="report-search-results" class="search-results"></div>
            </div>

            <label for="reason_select">Why do you believe this submission to be incorrect?</label>
            <select id="reason_select" name="reason_select" required>
              <option value="No Verification">An announcement/email about this exemption has not been made by an instructor.</option>
              <option value="Contacted Instructor">I contacted an instructor about the submission.</option>
              <option value="Is Instructor">I am an instructor for this course/section and believe this to be an incorrect submission.</option>
              <option value="Other">Other</option>
            </select>

            <div id="instructor-contact" style="display:none;">
              <label for="instructor_contact">Please provide the relevant instructor's email:</label>
              <input id="instructor_contact" name="instructor_contact" type="text"/>
            </div>

            <div id="other-explanation" style="display:none;">
              <label for="other_explanation">Please specify why you believe this submission to be incorrect:</label>
              <input id="other_explanation" name="other_explanation" type="text" style="display:none;"/>
            </div>

            <div style="display:none;">
            <label for="reporter_email">Your institutional email</label>
            <input
              type="email"
              id="reporter_email"
              name="reporter_email"
              style="cursor: not-allowed; pointer-events: none;"
              readonly
            />
            </div>

            <button type="submit" class="button">Submit</button>
          </form>
          <p id="report-status" class="status"></p>
        </div>
      </div>
    </div>
  </section>

  <div id="course-modal" class="modal" style="display:none;" aria-hidden="true">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h2>Course details</h2>
        <button id="close-modal" class="modal-close" aria-label="Close">✕</button>
      </div>
      <div class="modal-body">
        <p class="modal-institution"></p>
        <h3 class="modal-code-name"></h3>
        <p class="modal-exemption-type"></p>
        <p class="modal-description"></p>
      </div>
    </div>
  </div>

  <script define:vars={{ APPS_SCRIPT_URL, ALLOWED_INSTITUTIONS }}>
    let allCourses = [];
    let sortedInstitutions = []; 
    let searchableInstitutions = [];
    const courseSearch = document.getElementById("course-search");
    const searchResults = document.getElementById("search-results");
    const institutionsList = document.getElementById("institutions-list");

    const tabBtns = document.querySelectorAll(".tab-btn");
    const tabBrowse = document.getElementById("tab-browse");
    const tabSubmit = document.getElementById("tab-submit");
    const tabReport = document.getElementById("tab-report");

    const courseModal = document.getElementById("course-modal");
    const modalBackdrop = courseModal.querySelector(".modal-backdrop");
    const closeModalBtn = document.getElementById("close-modal");
    const modalInstitution = courseModal.querySelector(".modal-institution");
    const modalCodeName = courseModal.querySelector(".modal-code-name");
    const modalExemptionType = courseModal.querySelector(".modal-exemption-type");
    const modalDescription = courseModal.querySelector(".modal-description");

    const verifyForm = document.getElementById("verify-form");
    const verifyEmailInput = document.getElementById("verify-email");
    const verifyStatus = document.getElementById("verify-status");

    const submitStep = document.getElementById("submit-step");
    const verifyStep = document.getElementById("verify-step");
    const exemptionForm = document.getElementById("exemption-form");
    const submitStatus = document.getElementById("submit-status");
    const verifyButton = document.getElementById("verify-button");

    const instData = sortedInstitutions;
    const coursesData = allCourses;

    const reportVerifyForm = document.getElementById("report-verify-form");
    const reportVerifyEmailInput = document.getElementById("report-verify-email");
    const reportVerifyStatus = document.getElementById("report-verify-status");
    const reportVerifyButton = document.getElementById("report-verify-button");

    const reportSubmitStep = document.getElementById("report-submit-step");
    const reportVerifyStep = document.getElementById("report-verify-step");
    const reportForm = document.getElementById("report-form");
    const reportStatus = document.getElementById("report-status");
    const reporterEmailInput = document.getElementById("reporter_email");
    const reasonSelect = document.getElementById("reason_select");

    // Build static allowlist for submit form
    searchableInstitutions = ALLOWED_INSTITUTIONS.map(name => ({
      id: name.toLowerCase().replace(/\s+/g, "-"),
      name
    }));

    // load exemptions from spreadsheet
    (async function loadExemptions() {
      try {
        const res = await fetch(APPS_SCRIPT_URL + "?action=list-exemptions");
        const json = await res.json();
        if (json.error) {
          console.error("Failed to load exemptions:", json.error);
          institutionsList.innerHTML = "<p>Could not load exemptions.</p>";
          institutionsList.classList.remove("loading-state");
          return;
        }

        const items = json.items || [];

        if (!items.length) {
          institutionsList.innerHTML = "<p>No exemptions submitted yet.</p>";
          institutionsList.classList.remove("loading-state");
          return;
        }

        // Group by institution
        const byInst = new Map();
        items.forEach(item => {
          const instName = item.institution || "Unknown institution";
          if (!byInst.has(instName)) {
            byInst.set(instName, []);
          }
          byInst.get(instName).push(item);
        });

        // Build institutions array 
        sortedInstitutions = Array.from(byInst.entries())
          .sort((a, b) => a[0].localeCompare(b[0]))
          .map(([name, courses]) => ({
            name,
            courses: courses.map(c => ({
              code: c.course_code || "",
              name: c.course_name || "",
              exemption_type: c.exemption_type || "",
              description: c.description || "",
              info: c.info || ""
            }))
          }));

        // Flatten for search
        allCourses = sortedInstitutions.flatMap(inst =>
          inst.courses.map(c => ({
            institution: inst.name,
            code: c.code,
            name: c.name,
            exemption_type: c.exemption_type,
            description: c.description
          }))
        );

        institutionsList.innerHTML = ''; 
        institutionsList.classList.remove('loading-state');

        // Render institutions list
        renderInstitutions();

      } catch (err) {
        console.error("Error loading exemptions:", err);
        institutionsList.innerHTML = "<p>Could not load exemptions.</p>";
        institutionsList.classList.remove("loading-state");
      }
    })();

    function renderInstitutions() {
      institutionsList.innerHTML = "";

      sortedInstitutions.forEach((inst, idx) => {
        const block = document.createElement("div");
        block.className = "institution-block";
        block.dataset.index = idx;

        const header = document.createElement("button");
        header.className = "institution-header";
        header.innerHTML = `
          <span class="institution-name">${inst.name}</span>
          <span class="chevron">▶</span>
        `;

        const content = document.createElement("div");
        content.className = "institution-content";
        content.style.display = "none";

        if (inst.courses.length === 0) {
          content.innerHTML = "<p class='no-courses'>No courses listed yet.</p>";
        } else {
          const list = document.createElement("div");
          list.className = "courses-list";

          inst.courses
            .slice()
            .sort((a, b) => (a.code || "").localeCompare(b.code || ""))
            .forEach(c => {
              const card = document.createElement("div");
              card.className = "course-card";
              card.innerHTML = `
                <h3>${c.code} – ${c.name}</h3>
                <p class="exemption-type">${c.exemption_type}</p>
                <p class="description">${c.description}</p>
                <p class="info">Find your instructor's announcement: ${c.info}</p>
              `;
              list.appendChild(card);
            });

          content.appendChild(list);
        }

        block.appendChild(header);
        block.appendChild(content);
        institutionsList.appendChild(block);
      });
    }

    // listen for verification messages from Apps Script

    window.verifiedUserEmail = ""; // global email var
    // on page load, check for verification redirect params
    (async function handleVerificationRedirect() {
      const params = new URLSearchParams(window.location.search);
      const verifiedFlag = params.get("verified");
      const token = params.get("token");
      const email = params.get("email");
      const scope = params.get("scope") || "submit"; // ← add this

      if (verifiedFlag !== "1" || !token) {
        return;
      }

      try {
        const res = await fetch(
          APPS_SCRIPT_URL +
            "?action=check-token&token=" +
            encodeURIComponent(token) +
            "&email=" +
            encodeURIComponent(email)
        );
        const json = await res.json();

        if (json.verified) {
          window.verifiedUserEmail = email;

          const isReportVerification = scope === "report";

          if (isReportVerification) {
            // Activate Report tab
            tabBtns.forEach((button) => {
              button.classList.toggle(
                "active",
                button.dataset.tab === "report"
              );
            });

            tabBrowse.classList.remove("active");
            tabSubmit.classList.remove("active");
            tabReport.classList.add("active");

            reportVerifyStep.style.display = "none";
            reportSubmitStep.style.display = "block";

            const reporterEmailInput = document.getElementById("reporter_email");
            if (reporterEmailInput) {
              reporterEmailInput.value = email;
              reporterEmailInput.placeholder = email;
            }
          } else {
            // Activate Submit tab (default)
            tabBtns.forEach((button) => {
              button.classList.toggle(
                "active",
                button.dataset.tab === "submit"
              );
            });

            tabBrowse.classList.remove("active");
            tabSubmit.classList.add("active");
            tabReport.classList.remove("active");

            verifyStep.style.display = "none";
            submitStep.style.display = "block";

            const submitterEmailInput = document.getElementById("submitter_email");
            if (submitterEmailInput) {
              submitterEmailInput.value = email;
              submitterEmailInput.placeholder = email;
            }
          }

          verifyStatus.textContent = "Email verified. You may now submit your claim.";
          verifyStatus.className = "status success";
        } else {
          verifyStatus.textContent =
            "Verification could not be confirmed. Please request a new verification email.";
          verifyStatus.className = "status error";
        }
      } catch (err) {
        console.error("Verification check failed:", err);
        verifyStatus.textContent = "Failed to confirm verification.";
        verifyStatus.className = "status error";
      }
    })();

    // Handle verification signal URL
    (function handleVerifySignal() {
      const params = new URLSearchParams(window.location.search);
      const signal = params.get("signal-verify");
      const email = params.get("email");
      const token = params.get("token");

      if (signal !== "1" || !email || !token) {
        return;
      }

      // Write to localStorage as signal
      localStorage.setItem("exemption_verified_email", email);
      localStorage.setItem("exemption_verified_token", token);

      // Clear URL
      if (window.history && window.history.replaceState) {
        window.history.replaceState({}, "", window.location.pathname + window.location.hash);
      }

      // Try to close if this is a popup (verification tab)
      setTimeout(() => {
        if (window.opener && !window.opener.closed) {
          window.close();
        }
      }, 300);
    })();

    // Tabs: switch content, red underline on active
    tabBtns.forEach((button) => {
      button.addEventListener("click", () => {
        const tabName = button.dataset.tab;

        tabBtns.forEach((btn) => {
          btn.classList.toggle("active", btn === button);
        });

        tabBrowse.classList.toggle("active", tabName === "browse");
        tabSubmit.classList.toggle("active", tabName === "submit");
        tabReport.classList.toggle("active", tabName === "report");
      });
    });

    // Accordion: toggle institution open/close
    institutionsList.addEventListener("click", (e) => {
      const header = e.target.closest(".institution-header");
      if (!header) return;

      const block = header.closest(".institution-block");
      const content = block.querySelector(".institution-content");
      const chevron = block.querySelector(".chevron");

      const isOpen = block.classList.toggle("open");
      content.style.display = isOpen ? "block" : "none";
      chevron.textContent = isOpen ? "▼" : "▶";
    });

    // Search: show overlay dropdown of matching results
    courseSearch.addEventListener("input", () => {
      const query = courseSearch.value.trim().toLowerCase();
      searchResults.innerHTML = "";
      searchResults.classList.remove("show");

      if (!query) {
        return;
      }

      const matches = coursesData.filter(c =>
        c.code.toLowerCase().includes(query) ||
        c.name.toLowerCase().includes(query) ||
        c.institution.toLowerCase().includes(query)
      );

      if (!matches.length) {
        searchResults.innerHTML = "<div class='no-results'>No matching courses.</div>";
        searchResults.classList.add("show");
        return;
      }

      const list = document.createElement("div");
      list.className = "search-results-list";

      matches.forEach(m => {
        const item = document.createElement("button");
        item.className = "search-result-item";
        item.innerHTML = `
          <span class="result-code">${m.code}</span>
          <span class="result-name">${m.name}</span>
          <span class="result-institution">${m.institution}</span>
        `;
        item.addEventListener("click", () => {
          openCourseModal(m);
        });
        list.appendChild(item);
      });

      searchResults.appendChild(list);
      searchResults.classList.add("show");
    });

    // Close search dropdown when clicking outside
    document.addEventListener("click", (e) => {
      if (!e.target.closest(".search-wrap")) {
        searchResults.classList.remove("show");
      }
    });

    function openCourseModal(course) {
      searchResults.classList.remove("show");

      modalInstitution.textContent = course.institution;
      modalCodeName.textContent = `${course.code} – ${course.name}`;
      modalExemptionType.textContent = course.exemption_type;
      modalDescription.textContent = course.description;

      courseModal.style.display = "flex";
      courseModal.setAttribute("aria-hidden", "false");
    }

    function closeCourseModal() {
      courseModal.style.display = "none";
      courseModal.setAttribute("aria-hidden", "true");
    }

    closeModalBtn.addEventListener("click", closeCourseModal);
    modalBackdrop.addEventListener("click", closeCourseModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && courseModal.style.display === "flex") {
        closeCourseModal();
      }
    });

    reasonSelect.addEventListener("change", async (e) => {
      if (e.target.value == "Contacted Instructor" || e.target.value == "Is Instructor") {
        document.getElementById("instructor-contact").style.display = "";
      }
      if (e.target.value == "Other") {
        document.getElementById("other-explanation").style.display = "";
      }
    });

    // report submit
    reportForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!window.verifiedUserEmail) {
        reportStatus.textContent = "You must verify your institutional email before submitting a report.";
        reportStatus.className = "status error";
        return;
      }

      const formData = new FormData(reportForm);
      const payload = Object.fromEntries(formData.entries());

      payload.reporter_email = window.verifiedUserEmail;

      reportStatus.textContent = "Submitting report...";
      reportStatus.className = "status";

      try {
        const res = await fetch(APPS_SCRIPT_URL + "?action=report-submission", {
          method: "POST",
          headers: { "Content-Type": "application/json;charset=utf-8" },
          body: JSON.stringify(payload)
        });

        const json = await res.json();

        if (json.error) {
          reportStatus.textContent = json.error;
          reportStatus.className = "status error";
          return;
        }

        reportStatus.textContent = "Report submitted successfully.";
        reportStatus.className = "status success";
        reportForm.reset();
      } catch (err) {
        console.error("Report submission failed:", err);
        reportStatus.textContent = "Failed to submit report.";
        reportStatus.className = "status error";
      }
    });

    // email verification
    verifyForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = verifyEmailInput.value.trim();

      verifyStatus.textContent = "Checking verification status...";
      verifyStatus.className = "status";

      try {
        const res = await fetch(APPS_SCRIPT_URL + "?action=request-verify", {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({
            email,
            scope: "submit",
          })
        });

        const json = await res.json();

        if (json.error) {
          verifyStatus.textContent = json.error;
          verifyStatus.className = "status error";
          return;
        }

        if (json.alreadyVerified) {
          verifyStatus.textContent = "Your email is already verified. You may proceed to submit.";
          verifyStatus.className = "status success";
          verifyStep.style.display = "none";
          submitStep.style.display = "block";
          return;
        }

        verifyStatus.textContent = "Verification email sent. Please check your inbox and click the link.\nIf you don't see the email, wait a few minutes and check your junk/spam folder before making another request.";
        verifyStatus.className = "status success";
      } catch (err) {
        console.error(err);
        verifyStatus.textContent = "Failed to send verification email.";
        verifyStatus.className = "status error";
      }
    });

    // report tab: email verification 
    reportVerifyForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = reportVerifyEmailInput.value.trim();

      reportVerifyStatus.textContent = "Checking verification status...";
      reportVerifyStatus.className = "status";

      try {
        const res = await fetch(APPS_SCRIPT_URL + "?action=request-verify", {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({
            email,
            scope: "report",
          })
        });

        const json = await res.json();

        if (json.error) {
          reportVerifyStatus.textContent = json.error;
          reportVerifyStatus.className = "status error";
          return;
        }

        if (json.alreadyVerified) {
          reportVerifyStatus.textContent = "Your email is already verified. You may proceed to submit a report.";
          reportVerifyStatus.className = "status success";
          reportVerifyStep.style.display = "none";
          reportSubmitStep.style.display = "block";

          // Set global verified email if not set yet
          if (!window.verifiedUserEmail) {
            window.verifiedUserEmail = email;
          }
          reporterEmailInput.value = window.verifiedUserEmail;
          reporterEmailInput.placeholder = window.verifiedUserEmail;
          return;
        }

        reportVerifyStatus.textContent = "Verification email sent. Please check your inbox and click the link.\nIf you don't see the email, wait a few minutes and check your junk/spam folder before making another request.";
        reportVerifyStatus.className = "status success";
      } catch (err) {
        console.error(err);
        reportVerifyStatus.textContent = "Failed to send verification email.";
        reportVerifyStatus.className = "status error";
      }
    });

    // Institution autocomplete (uses static ALLOWED_INSTITUTIONS)
    const institutionInput = document.getElementById("institution");
    const institutionResults = document.getElementById("institution-results");
    const institutionIdInput = document.getElementById("institution-id");
    const institutionStatus = document.getElementById("institution-status");
    const institutionalEmail = document.getElementById("submitter_email");

    let isValidSelection = false;

    institutionalEmail.placeholder = verifyEmailInput.value.trim();

    institutionInput.addEventListener("input", () => {
      const query = institutionInput.value.trim().toLowerCase();
      institutionResults.innerHTML = "";
      institutionResults.classList.remove("show");

      isValidSelection = false;
      institutionIdInput.value = ""; 

      if (!query) return;

      const matches = searchableInstitutions.filter(inst =>
        inst.name.toLowerCase().includes(query)
      );

      if (!matches.length) return;

      matches.forEach(inst => {
        const btn = document.createElement("button");
        btn.className = "autocomplete-item";
        btn.textContent = inst.name;

        btn.addEventListener("mousedown", (e) => {
          e.preventDefault();
          institutionInput.value = inst.name;
          institutionIdInput.value = inst.id;
          isValidSelection = true;
          institutionResults.innerHTML = "";
          institutionResults.classList.remove("show");
        });
        institutionResults.appendChild(btn);
      });

      institutionResults.classList.add("show");
    });

    institutionInput.addEventListener("blur", () => {
      setTimeout(() => {
        institutionResults.classList.remove("show");
      }, 200);

      const exactMatch = searchableInstitutions.find(
        inst => inst.name.toLowerCase() === institutionInput.value.trim().toLowerCase()
      );

      if (exactMatch) {
        institutionInput.value = exactMatch.name;
        institutionIdInput.value = exactMatch.id;
        isValidSelection = true;
        institutionStatus.textContent = "";
      } else if (!isValidSelection) {
        institutionInput.value = "";
        institutionIdInput.value = "";
        institutionStatus.textContent = "ⓘ Please choose an institution from the list.";
      }
    });

    const nameInput = document.getElementById("submitter_name");
    const nameStatus = document.getElementById("name-status");

    let isNameValid = false;

    nameInput.addEventListener("input", () => {
      const query = nameInput.value.trim();

      const fullNameRegex = /^[a-zA-Z'-]+(?:\s+[a-zA-Z'-]+)+$/;

      if (!fullNameRegex.test(query)) {
        isNameValid = false;
        if (query.length > 0) {
          nameStatus.textContent = "ⓘ Please enter your full name (first and last name).";
          nameStatus.className = "status error";
        } else {
          nameStatus.textContent = "";
        }
      } else {
        isNameValid = true;
        nameStatus.textContent = "";
      }
    });

    nameInput.addEventListener("blur", () => {
      const query = nameInput.value.trim();

      if (!query) {
        isNameValid = false;
        nameStatus.textContent = "";
        return;
      }

      const fullNameRegex = /^[a-zA-Z'-]+(?:\s+[a-zA-Z'-]+)+$/;

      if (!fullNameRegex.test(query)) {
        isNameValid = false;
        nameInput.value = "";
        nameStatus.textContent = "ⓘ Please enter your full name (first and last name).";
        nameStatus.className = "status error";
      } else {
        isNameValid = true;
        nameStatus.textContent = "";
      }
    });

    // SUBMITTING AND UPDATING SPREADSHEET
    exemptionForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(exemptionForm);
      const payload = Object.fromEntries(formData.entries());

      payload.submitter_email = window.verifiedUserEmail || verifyEmailInput.value.trim();
      payload.vow = document.getElementById("vow").checked;

      submitStatus.textContent = "Submitting...";
      submitStatus.className = "status";

      try {
        console.log("Submitting to:", APPS_SCRIPT_URL + "?action=submit-exemption");
        const res = await fetch(APPS_SCRIPT_URL + "?action=submit-exemption", {
          method: "POST",
          headers: { "Content-Type": "application/json;charset=utf-8" },
          body: JSON.stringify(payload)
        });

        const json = await res.json();

        console.log("Status:", res.status, res.ok);
        console.log("Raw response text:", json);

        if (json.error) {
          console.log(json.error);
          submitStatus.textContent = json.error;
          submitStatus.className = "status error";
          return;
        }

        submitStatus.textContent = "Exemption submitted successfully.";
        submitStatus.className = "status success";
        exemptionForm.reset();
      } catch (err) {
        console.error("Submission failed:", err);
        submitStatus.textContent = "Failed to submit exemption.";
        submitStatus.className = "status error";
      }
    });

  </script>

