    </div>
  </section>
  </div>

  <button
  class="trillium-control"
  type="button"
  aria-expanded="false"
  aria-label="Show coalition: tenants, students, labour"
>
  <span class="trillium-tooltip" aria-hidden="true">
    Tenants, students, workers
  </span>

  <img
    src={trilliumImage.src}
    alt=""
    class="trillium-mark"
