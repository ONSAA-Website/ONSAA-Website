</Layout>

<script is:inline define:vars={{ targetDateTime, appsScriptUrl }}>
  const countdownElements = {
    days: document.getElementById("days"),
    hours: document.getElementById("hours"),
    minutes: document.getElementById("minutes"),
    seconds: document.getElementById("seconds"),
  };

  const signatureCountElement = document.getElementById("signature-count");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  function formatNumber(value) {
    return String(value).padStart(2, "0");
  }

  function formatCount(value) {
    return Number(value).toLocaleString();
  }

  function updateCountdown() {
    const targetTime = new Date(targetDateTime).getTime();
    const currentTime = Date.now();
    const remaining = Math.max(0, targetTime - currentTime);

    const totalSeconds = Math.floor(remaining / 1000);
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;

    countdownElements.days.textContent = formatNumber(days);
    countdownElements.hours.textContent = formatNumber(hours);
    countdownElements.minutes.textContent = formatNumber(minutes);
    countdownElements.seconds.textContent = formatNumber(seconds);
  }

  function easeOutCubic(t) {
    return 1 - Math.pow(1 - t, 3);
  }

  function animateSignatureCount(targetValue) {
    const finalValue = Math.max(0, Number(targetValue) || 0);

    signatureCountElement.classList.remove("is-loading");

    if (prefersReducedMotion) {
      signatureCountElement.textContent = formatCount(finalValue);
      return;
    }

    signatureCountElement.classList.add("is-animating");

    const flickerDuration = 420;
    const countDuration = 1400;
    const flickerStart = performance.now();

    function flickerFrame(now) {
      const elapsed = now - flickerStart;
      const progress = Math.min(elapsed / flickerDuration, 1);

      const fakeMax = Math.max(52, finalValue * 3);
      const jitter = Math.floor(Math.random() * fakeMax);
      signatureCountElement.textContent = formatCount(jitter);

      if (progress < 1) {
        requestAnimationFrame(flickerFrame);
      } else {
        const countStart = performance.now();

        function countFrame(frameNow) {
          const countElapsed = frameNow - countStart;
          const countProgress = Math.min(countElapsed / countDuration, 1);
          const eased = easeOutCubic(countProgress);
          const currentValue = Math.round(finalValue * eased);

          signatureCountElement.textContent = formatCount(currentValue);

          if (countProgress < 1) {
            requestAnimationFrame(countFrame);
          } else {
            signatureCountElement.textContent = formatCount(finalValue);
            signatureCountElement.classList.remove("is-animating");
          }
        }

        requestAnimationFrame(countFrame);
      }
    }

    requestAnimationFrame(flickerFrame);
  }

  async function loadSignatureCount() {
    try {
      const response = await fetch(appsScriptUrl);
      const data = await response.json();
      animateSignatureCount(data.count || 0);
    } catch (error) {
      console.error(error);
      signatureCountElement.classList.remove("is-loading");
      signatureCountElement.textContent = "11"; // last updated value; use as fallback
    }
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
  loadSignatureCount();

  const flickerNodes = [...document.querySelectorAll(".flicker-node")];
  const asciiGame = document.getElementById("ascii-game");

  const notes = [261.63, 329.63, 392.0, 523.25, 392.0, 329.63];
  const jingle = [
    { note: "E4", beats: 0.5 }, { note: "A4", beats: 0.5 }, { note: "B4", beats: 0.5 }, { note: "C5", beats: 0.5 }, { note: "A4", beats: 1.5 },
    { note: "E4", beats: 0.5 }, { note: "A4", beats: 0.5 }, { note: "B4", beats: 0.5 }, { note: "C5", beats: 0.5 }, { note: "A4", beats: 1.5 },
    { note: "E4", beats: 0.5 }, { note: "A4", beats: 0.5 }, { note: "B4", beats: 0.5 }, { note: "C5", beats: 0.5 }, { note: "B4", beats: 0.5 }, { note: "A4", beats: 0.5 }, { note: "C5", beats: 0.5 }, { note: "B4", beats: 0.5 }, { note: "A4", beats: 1 }, { note: "E5", beats: 1 },
  ];
  const jingleLength = jingle.length;


  let activeIndex = 0;
  let completedSteps = 0;
  let audioContext = null;
  let soundArmed = false;
  let isCompleting = false;

  const NOTE = {
    C4: 261.63,
    "C#4": 277.18,
    D4: 293.66,
    "D#4": 311.13,
    E4: 329.63,
    F4: 349.23,
    "F#4": 369.99,
    G4: 392.0,
    "G#4": 415.3,
    A4: 440.0,
    "A#4": 466.16,
    B4: 493.88,
    C5: 523.25,
    D5: 587.33,
    E5: 659.25,
    F5: 698.46,
    G5: 783.99,
  };


  function playTone(frequency, delay = 0, duration = 0.18) {
    if (!audioContext || audioContext.state !== "running") {
      console.log("Sound blocked. Context state:", audioContext?.state);
      return;
    }

    const startTime = audioContext.currentTime + delay;
    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();

    oscillator.type = "sine";
    oscillator.frequency.setValueAtTime(frequency, startTime);

    gain.gain.setValueAtTime(0.0001, startTime);
    gain.gain.exponentialRampToValueAtTime(0.18, startTime + 0.015);
    gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);

    oscillator.connect(gain);
    gain.connect(audioContext.destination);

    oscillator.start(startTime);
    oscillator.stop(startTime + duration + 0.04);
  }

  function activateNode(index) {
    flickerNodes.forEach((node, nodeIndex) => {
      node.classList.toggle("is-active", nodeIndex === index);
    });

    activeIndex = index;
  }

  function finishFlickerGame() {
    isCompleting = true;

    flickerNodes.forEach((node) => {
      node.classList.remove("is-active");
    });

    asciiGame?.classList.add("signal-complete");

    const bpm = 110;
    const secondsPerBeat = 60 / bpm;
    let delay = 0;
    jingle.forEach(({ note, beats }) => {
      const duration = beats * secondsPerBeat * 0.9;

      playTone(NOTE[note], delay, duration);

      delay += beats * secondsPerBeat;
    });

    window.setTimeout(() => {
      completedSteps = 0;
      isCompleting = false;
      asciiGame?.classList.remove("signal-complete");
      activateNode(0);
    }, 7000);
  }

  async function armSound() {
  if (!audioContext) {
    audioContext = new AudioContext();
  }

  if (audioContext.state !== "running") {
    await audioContext.resume();
  }

  return audioContext.state === "running";
}

  function collectActiveNode(index) {
    if (isCompleting || index !== activeIndex) return;

    const currentNote = jingle[completedSteps % jingleLength].note;
    playTone(NOTE[currentNote], 0, 0.22);

    completedSteps += 1;

    if (completedSteps >= flickerNodes.length) {
      finishFlickerGame();
      return;
    }

    activateNode((activeIndex + 1) % flickerNodes.length);
  }

  flickerNodes.forEach((node, index) => {
    node.addEventListener("pointerdown", async (event) => {
      if (index !== activeIndex || isCompleting) return;

      event.preventDefault();

      const ready = await armSound();

      if (!ready) {
        console.warn("Audio is still unavailable:", audioContext?.state);
        return;
      }

      soundArmed = true;
      collectActiveNode(index);
    });

    node.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      if (!soundArmed || audioContext?.state !== "running") return;

      collectActiveNode(index);
    });
  });

  activateNode(0);

  // sound test
  document.addEventListener("keydown", (event) => {
    if (event.key !== "s") return;

    if (!audioContext) {
      audioContext = new AudioContext();
    }

    audioContext.resume().then(() => {
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();

      oscillator.type = "square";
      oscillator.frequency.value = 440;

      gain.gain.value = 0.35;

      oscillator.connect(gain);
      gain.connect(audioContext.destination);

      oscillator.start();
      oscillator.stop(audioContext.currentTime + 1);
    });
  });
</script>
