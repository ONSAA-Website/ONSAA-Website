        <p class="signature-panel" aria-label="Petition signatures">
          <span class="status-dot" aria-hidden="true"></span>
          <strong
            id="signature-count"
            class="is-loading"
            aria-live="polite"
          >—</strong>
          <span class="signature-unit">students have signed</span>
        </p>
      </div>

      <div style="display:flex; flex-direction:column; justify-content:center; align-items:center;">
        <a class="text-link" href={url("/volunteer/")}>
          Volunteer with us <span aria-hidden="true">-&gt;</span>
