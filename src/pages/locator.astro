---
import Layout from "../layouts/Layout.astro";

const {
  eventsUrl = "https://script.google.com/macros/s/AKfycbwoj_MvFoCHT6JBuDExLqLH7__HyGYdnfax5jSZRcs5khWjT0rl4e8ec9-oDAHL_9iF/exec",
  defaultLat = 43.6532,
  defaultLng = -79.3832,
  targetDate = "2026-11-05"
} = Astro.props;
---

<Layout
  title={`Local Events on ${targetDate} | ONSAA`}
  description="Find local ONSAA events near you."
  current="/locator/"
  contentMax="1040px"
>
  <Fragment slot="head">
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="
        default-src 'self';
        script-src 'self' 'unsafe-inline' https://unpkg.com;
        style-src 'self' 'unsafe-inline' https://unpkg.com;
        connect-src 'self' https://script.google.com https://script.googleusercontent.com https://nominatim.openstreetmap.org;
        img-src 'self' data: https://script.googleusercontent.com https://www.gstatic.com https://*.tile.openstreetmap.org https://tile.openstreetmap.org;
        font-src 'self';
      "
    />
  </Fragment>

  <section class="page-shell">
    <div class="inner-shell">
      <section class="page-header">
        <h1>Local Events</h1>
      </section>

      <section class="map-section">
        <div class="map-wrap">
          <div id="events-map"></div>
          <div id="events-status" class="events-status">Locating you…</div>
          <button id="zoom-out-btn" class="zoom-out-btn" style="display:none;">← Zoom out</button>
        </div>
      </section>
    </div>
  </section>

  <script define:vars={{ eventsUrl, defaultLat, defaultLng, targetDate }}>
    function loadLeaflet(callback) {
      function loadScript(src) {
        return new Promise((resolve) => {
          const script = document.createElement("script");
          script.src = src;
          script.onload = resolve;
          document.head.appendChild(script);
        });
      }
      function loadCss(href) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = href;
        document.head.appendChild(link);
      }

      loadCss("https://unpkg.com/leaflet@1.9.4/dist/leaflet.css");
      loadScript("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js").then(callback);
    }

    loadLeaflet(() => {
      const EVENTS_URL = eventsUrl;
      const GEOCODE_URL = "https://nominatim.openstreetmap.org/search";
      const DEFAULT_LAT = defaultLat;
      const DEFAULT_LNG = defaultLng;
      const TARGET_DATE = targetDate;

      const map = L.map("events-map", {
        center: [DEFAULT_LAT, DEFAULT_LNG],
        zoom: 12,
        minZoom: 3,
        maxZoom: 18,
        scrollWheelZoom: true,
        doubleClickZoom: true,
        touchZoom: false,
        boxZoom: false,
        keyboard: false,
        tap: true,
        attributionControl: false,
      });

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "© OpenStreetMap contributors",
        crossOrigin: true // anonymous
      }).addTo(map);

      const homeZoom = map.getZoom();
      const homeCenter = map.getCenter();
      const zoomOutBtn = document.getElementById("zoom-out-btn");
      const statusEl = document.getElementById("events-status");

      if ("geolocation" in navigator) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            map.setView([pos.coords.latitude, pos.coords.longitude], 13);
            statusEl.textContent = "Showing events near your location.";
            loadAndShowEvents();
          },
          () => {
            statusEl.textContent = "Location not available. Showing default city.";
            loadAndShowEvents();
          },
          { enableHighAccuracy: true, timeout: 8000 }
        );
      } else {
        statusEl.textContent = "Geolocation not supported. Showing default city.";
        loadAndShowEvents();
      }

      async function loadAndShowEvents() {
        try {
          const res = await fetch(EVENTS_URL);
          const json = await res.json();
          const allItems = json.items || [];

          const events = allItems.filter(item => {
            const d = item.date;
            if (!d) return false;
            const dateStr = (d instanceof Date)
              ? d.toISOString().slice(0, 10)
              : String(d).slice(0, 10);
            return dateStr === TARGET_DATE;
          });

          if (!events.length) {
            statusEl.textContent = `No events found for ${TARGET_DATE}.`;
            return;
          }

          for (const ev of events) {
            let lat = ev.lat;
            let lng = ev.lng;

            if (!lat || !lng) {
              if (!ev.address) continue;
              const coords = await geocodeAddress(ev.address);
              if (!coords) continue;
              lat = coords.lat;
              lng = coords.lon;
            }

            const marker = L.marker([lat, lng], {
              icon: L.divIcon({
                html: `<div class="event-dot"></div>`,
                className: "event-dot-wrap",
                iconSize: L.point(12, 12),
                iconAnchor: L.point(6, 6),
              }),
            });

            const popupHtml = `
              <div class="leaflet-popup-custom">
                <h2>${ev.event_name || "Event"}</h2>
                <p>${ev.description || ""}</p>
                <small>${ev.address || ""}</small><br>
                ${ev.url ? `<a href="${ev.url}" target="_blank" class="popup-link">Details</a>` : ""}
              </div>
            `;

            marker.bindPopup(popupHtml, { closeButton: false, offset: [0, -8] });

            let closeTimeout;

            marker.on("mouseover", () => {
              clearTimeout(closeTimeout);
              marker.openPopup();
            });

            marker.on("mouseout", () => {
              closeTimeout = setTimeout(() => {
                const popupEl = marker.getPopup().getElement();
                if (popupEl && popupEl.matches(":hover")) return;
                marker.closePopup();
              }, 100);
            });

            marker.on("popupopen", () => {
              const popupEl = marker.getPopup().getElement();
              if (popupEl) {
                popupEl.addEventListener("mouseenter", () => clearTimeout(closeTimeout));
                popupEl.addEventListener("mouseleave", () => marker.closePopup());
              }
            });

            marker.on("click", (e) => {
              L.DomEvent.stopPropagation(e);
              zoomOutBtn.style.display = "block";
            });

            marker.addTo(map);
          }
        } catch (err) {
          console.error("Failed to load events:", err);
          statusEl.textContent = "Failed to load events.";
        }
      }

      async function geocodeAddress(address) {
        const url =
          GEOCODE_URL +
          "?format=json&q=" +
          encodeURIComponent(address) +
          "&limit=1";

        const res = await fetch(url, { headers: { Accept: "application/json" } });
        const data = await res.json();
        if (!data || !data.length) return null;
        const r = data[0];
        return { lat: parseFloat(r.lat), lon: parseFloat(r.lon) };
      }

      zoomOutBtn.addEventListener("click", () => {
        map.setView(homeCenter, homeZoom, { animate: false });
        zoomOutBtn.style.display = "none";
      });
    });
  </script>

  <style is:global>

    /* locking page scroll */
    body {
      margin: 0;
      height: 100vh;
      overflow: hidden;
    }

    .page-shell {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      height: calc(100vh - (var(--edge-size) * 2)) !important;
      padding: 24px !important;
      padding-bottom: 24px !important;
      box-sizing: border-box !important;
    }

    .page-shell .inner-shell {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-height: 0;
    }

    .page-header {
      flex: 0 0 auto;
      padding: 4px 0 2px !important;
      margin: 0 !important;
    }

    .page-header h1 {
      margin: 0 !important;
      font-size: 2rem; 
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .map-section {
      flex: 1;
      display: flex;
      min-height: 0;
      margin: 0 !important;
      padding: 0 !important;
    }

    .map-wrap {
      flex: 1;
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 0;
      overflow: hidden;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      margin: 0 !important;
      padding: 0 !important;
    }

    #events-map {
      width: 100%;
      height: 100%;
      background: rgba(10, 10, 10, 0.6);
    }

    .events-status {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 1000;
      background: rgba(10, 10, 10, 0.85);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 6px;
      padding: 8px 12px;
      font-size: 0.8rem;
      pointer-events: none;
    }

    .zoom-out-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 1000;
      background: rgba(10, 10, 10, 0.85);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: background 150ms ease;
    }

    .zoom-out-btn:hover {
      background: rgba(255, 59, 48, 0.85);
    }

    .leaflet-popup-content-wrapper {
      background: rgba(10, 10, 10, 0.94) !important;
      color: #fff !important;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 6px;
    }

    .leaflet-popup-content {
      margin: 12px 14px;
      color: #fff !important;
    }

    .leaflet-popup-tip {
      background: rgba(10, 10, 10, 0.94) !important;
    }

    .leaflet-popup-custom {
      color: #fff !important;
      background: transparent !important;
    }

    .leaflet-popup-custom h2 {
      color: #fff !important;
      font-size: 0.95rem;
      margin: 0 0 6px;
    }

    .leaflet-popup-custom p {
      color: rgba(255, 255, 255, 0.85) !important;
      font-size: 0.85rem;
      margin: 0 0 6px;
    }

    .leaflet-popup-custom small {
      color: rgba(255, 255, 255, 0.7) !important;
      font-size: 0.8rem;
    }

    .popup-link {
      color: #ff3b30 !important;
      text-decoration: none;
      font-size: 0.85rem;
    }

    .popup-link:hover {
      text-decoration: underline;
    }

    .event-dot-wrap {
      background: transparent;
      border: none;
    }

    .event-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #e13434;
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3);
    }
  </style>
</Layout>