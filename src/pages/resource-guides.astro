---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Resource guide | ONSAA"
  description="Resources, reading, and organizing tools from ONSAA."
  current="/resource-guides/"
  contentMax="1080px"
>
  <section class="page-shell">
    <div class="inner-shell">
      <section class="page-header">
        <h1>Resource guides</h1>
        <p>
          A starting point for organizing, reading, and helping students make
          sense of austerity and collective action.
        </p>
      </section>

      <div class="resource-grid">
        <article class="resource-card">
          <h2>Housing</h2>

          <ul>
            <li>
              <strong>City of Toronto Shelter Intake</strong> — A 24/7 phone-based
              service that helps people find immediate emergency shelter anywhere in
              the city. A caseworker asks about the situation and uses a centralized
              system to locate an available shelter space that fits the caller's
              needs.
              <ul>
                <li>
                  Phone:{" "}
                  <a href="tel:+14163384766">416-338-4766</a>
                </li>
                <li>
                  Toll-free:{" "}
                  <a href="tel:+18773383398">1-877-338-3398</a>
                </li>
              </ul>
            </li>

            <li>
              <strong>Fred Victor Housing Services</strong> — Emergency and
              transitional housing with wraparound supports.
              <ul>
                <li>
                  Phone:{" "}
                  <a href="tel:+14163648228">416-364-8228</a>
                </li>
              </ul>
            </li>

            <li>
              <strong>YWCA Toronto Housing</strong> — Emergency and long-term housing
              for women and gender-diverse people. It is not limited to people fleeing
              domestic violence.
              <ul>
                <li>
                  Phone:{" "}
                  <a href="tel:+16477339155">647-733-9155</a>
                </li>
              </ul>
            </li>
          </ul>
        </article>

        <article class="resource-card">
          <h2>Food</h2>

          <ul>
            <li>
              <strong>The People's Pantry</strong> — Founded by QT/BIPOC graduate
              students. Provides free home-cooked meals and grocery packages. No
              fixed address required.
            </li>

            <li>
              <strong>U of T Student Food Bank</strong> — Food Bank Room 136 at
              Student Commons. Open from 11:00 AM to 3:00 PM every Friday.
              Appointments can be booked online starting at 9:30 AM every Wednesday.
              Student-run.
            </li>

            <li>
              <strong>The Stop Community Food Centre</strong> — Emergency food access
              and social service programs, including a food bank, drop-in meal
              locations, and community kitchens.
            </li>

            <li>
              <strong>Daily Bread Food Bank network</strong> — A citywide locator for
              finding the nearest food bank, including locations providing fresh
              produce, dairy, and pantry staples.
            </li>

            <li>
              <strong>North York Harvest Food Bank</strong> — A key resource for
              students living in North York.
              <ul>
                <li>
                  Intake:{" "}
                  <a href="tel:+14166357771">416-635-7771 ext. 4600</a>
                </li>
              </ul>
            </li>

            <li>
              <strong>Parkdale Community Food Bank</strong> — A high-volume,
              barrier-free food bank near Trinity Bellwoods.
            </li>

            <li>
              <strong>Fort York Food Bank</strong> — Located at 380 College Street;
              accessible to students in the downtown area.
            </li>

            <li>
              <strong>FoodShare Toronto</strong> — Partners with mutual-aid groups and
              campuses to provide produce boxes and subsidized food programs.
            </li>

            <li>
              <strong>211 Ontario</strong> — Dial{" "}
              <a href="tel:211">211</a> to connect with services that can help locate
              free or low-cost prepared meals and food banks across Toronto.
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .resource-card {
    background: transparent !important;
    backdrop-filter: none !important;
    box-shadow: none !important;
    border: 0 !important;
  }

  .resource-card h2 {
    padding: 6px 0 6px 12px;
    border-left: 5px solid var(--accent);
    margin: 0 0 10px;
    color: #fff;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .resource-card a,
  .article-body a {
    color: #fff;
    text-decoration: underline;
  }

  .resource-card ul {
    margin: 12px 0 0;
    padding-left: 18px;
  }

  .resource-card > ul > li + li {
    margin-top: 18px;
  }

  @media (max-width: 900px) {
    .resource-grid {
      width: 100%;
      grid-template-columns: 1fr;
    }
  }
</style>
